{
  "version": 2,
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "framework": null,
  "routes": [
    {
      "src": "/items(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/kpis(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/history(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/finance(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/chapter-scores(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/chapter-shipments(.*)",
      "dest": "/api/index.py"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
